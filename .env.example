# SEC asks automated clients to identify themselves with a contact address.
SEC_USER_AGENT=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# qwen3:4b recommended; llama3.2 and deepseek-r1:8b remain configurable.
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_PATH=data/vector_store
CHUNK_SIZE=1600
CHUNK_OVERLAP=200

# Optional TypeSafe Jev decision engine. Keep disabled without an API key.
ENABLE_JEV=false
THESISLENS_OFFLINE=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_CONFIDENCE_THRESHOLD=0.70

# Personal watchlist, theses, history, and dated public disclosures.
THESISLENS_DB=data/local/thesislens.sqlite3

# Optional free notifications. Defaults to local outbox only; no credentials required.
THESISLENS_NOTIFICATION_CHANNEL=local
THESISLENS_QUIET_START_UTC=22:00
THESISLENS_QUIET_END_UTC=07:00
THESISLENS_DAILY_NOTIFICATION_CAP=20
# If channel=telegram, set your ordinary free Bot API token and chat ID locally.
THESISLENS_TELEGRAM_BOT_TOKEN=
THESISLENS_TELEGRAM_CHAT_ID=
# If channel=ntfy, use a trusted self-hosted/local server and topic.
THESISLENS_NTFY_BASE_URL=http://127.0.0.1:2586
THESISLENS_NTFY_TOPIC=
